DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DB_NAME"
NODE_ENV=development
PORT=5001

# at least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# comma separated frontends allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# number of proxies in front of the app (0 locally, 1 behind nginx / render / heroku)
TRUST_PROXY=0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
