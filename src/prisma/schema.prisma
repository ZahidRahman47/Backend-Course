// schema prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// USER => MOVIE => USERWATCHLIST

model User {
  id        String        @id @default(uuid())
  name      String
  email     String        @unique
  password  String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  watchlist UserWatchList[]
}

model Movie {
  id          String        @id @default(uuid())
  title       String
  description String?
  releaseYear Int?
  duration    Int?
  genre       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  watchlist   UserWatchList[]
}

model UserWatchList {
  id        String   @id @default(uuid())
  userId    String
  movieId   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@map("user_watchlist")
}
